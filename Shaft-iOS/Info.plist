<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shaft.referral</string>
			<key>CFBundleURLSchemes</key>
			<array><string>shaftintent</string></array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- shaft-api-v2 (当前最热 / 站长推荐 / 操作记录) is served over plaintext
		     HTTP on a bare IP; ATS blocks that by default. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Downloaded novel TXT files live in Documents/Novels; expose them in Files. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
</dict>
</plist>
